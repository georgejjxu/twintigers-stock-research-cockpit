<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>ca.twintigers.research</groupId><artifactId>research-parent</artifactId><version>1.0.0</version></parent>
  <artifactId>app-mcp</artifactId>
  <description>MCP server (stdio) exposing the use cases as tools. Builds target/research-mcp.jar.</description>
  <dependencies>
    <dependency><groupId>ca.twintigers.research</groupId><artifactId>adapters</artifactId></dependency>
    <dependency><groupId>io.modelcontextprotocol.sdk</groupId><artifactId>mcp</artifactId></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId></dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId>
        <executions><execution><phase>package</phase><goals><goal>shade</goal></goals>
          <configuration>
            <createDependencyReducedPom>false</createDependencyReducedPom>
            <finalName>research-mcp</finalName>
            <transformers>
              <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer"><mainClass>ca.twintigers.research.mcp.McpMain</mainClass><manifestEntries><Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access></manifestEntries></transformer>
            </transformers>
            <filters><filter><artifact>*:*</artifact><excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude><exclude>META-INF/MANIFEST.MF</exclude><exclude>module-info.class</exclude><exclude>META-INF/versions/*/module-info.class</exclude></excludes></filter></filters>
          </configuration></execution></executions>
      </plugin>
    </plugins>
  </build>
</project>
