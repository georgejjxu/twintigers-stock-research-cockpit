# Settings for TwintigersInvestmentAdviser. Copy this file to secrets.env (start.cmd does it on the first run) and fill
# it in. secrets.env is ignored by git: never commit or share it. After a change: scripts\cockpit.ps1 -Restart.

# Required by the SEC for its free data API (financial-health audits): your name and email.
SEC_USER_AGENT="Your Name you@example.com"

# Phone notifications for price alerts (optional): install the ntfy app, subscribe to a long random topic name, put it
# here. Anyone who knows the topic can read it, so make it hard to guess.
# NTFY_TOPIC="twintigers-change-this-to-something-random"
# NTFY_URL="https://ntfy.sh"

# Where holdings come from: "local" = the Cockpit's own ledger (default).
PORTFOLIO_SOURCE="local"

# Optional second price source if Yahoo Finance fails (free key from alphavantage.co).
# ALPHAVANTAGE_API_KEY=""

# Optional, only to copy accounts and transactions once from a running Ghostfolio (research-cli ledger-sync):
# GHOSTFOLIO_URL="http://host.docker.internal:3333"
# GHOSTFOLIO_TOKEN=""
